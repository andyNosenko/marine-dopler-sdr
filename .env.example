# Target yard location and candidate filters
YARD_LAT=59.9343
YARD_LON=30.3351
MAX_DIST_KM=30
SECTOR_DEG=30
MIN_VESSEL_LENGTH=60
MAX_VESSEL_LENGTH=180
MIN_VESSEL_AGE=12
FUSION_WINDOW_S=30

# Local AIS input and RDF calibration
AIS_LOCAL_PORT=10110
RDF_CAL_OFFSET=0
RDF_INVERT_SIGN=false
ENABLE_CH16_SCAN=false

# Optional external AIS feeds
AISHUB_PORT=
MT_SERVER_IP=
MT_SERVER_PORT=

# Optional vessel-data provider and SMTP account for manual proposal sending
PROVIDER_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_URL=https://api.telegram.org
# Telegram user ID authorized to trigger proposal sending.
TELEGRAM_OPERATOR_ID=123456789

# Local database
DB_PATH=/tmp/shipyard.db

# GPIO antenna switch (physical control lines on Orange Pi Zero 3)
GPIO_CHIP=/dev/gpiochip1
GPIO_LINE_A=73
GPIO_LINE_B=70
GPIO_LINE_GATE=69

# Mock SDR settings (used only with MOCK_SDR=true)
MOCK_SDR=false
MOCK_BEARING_INTERVAL_S=30
MOCK_BEARING_DEG=0
MOCK_BEARING_QUALITY=0.95
MOCK_BEARING_COUNT=0
